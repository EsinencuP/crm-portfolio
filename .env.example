# Required: use a local database for development and a dedicated hosted database on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crm_portfolio?schema=public"

# Optional direct connection for applying Prisma schema changes to a hosted database.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST:5432/crm_portfolio?schema=public"

# Required: generate a new, private value (for example with `npx auth secret`).
AUTH_SECRET="replace-with-a-unique-random-secret"

# Optional locally. If set, use the actual origin/port; do not point a Vercel deployment at localhost.
NEXTAUTH_URL="http://localhost:3000"

# Optional Google sign-in. Register /api/auth/callback/google for the deployed domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional AI briefs, deal scoring, and email drafts.
OPENAI_API_KEY=""

# Email OAuth. Register both callback paths below against this public origin.
EMAIL_OAUTH_BASE_URL="http://localhost:3000"
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
# Required for connected email accounts: 32 random bytes, base64 encoded.
EMAIL_TOKEN_ENCRYPTION_KEY=""
# Required by the standalone email sync worker.
REDIS_URL="redis://localhost:6379"

# Public HTTPS origin for open/click tracking links (may match EMAIL_OAUTH_BASE_URL).
EMAIL_TRACKING_BASE_URL="http://localhost:3000"
# Required when tracking is enabled: a separate random secret, at least 32 characters.
EMAIL_TRACKING_SECRET=""

# Optional Twilio click-to-call. Numbers must use E.164 (+country code).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Operator phone rings first, then Twilio bridges to the saved contact number.
TWILIO_AGENT_PHONE_NUMBER=""
# Public HTTPS origin; falls back to NEXTAUTH_URL. Use an HTTPS tunnel locally.
TWILIO_WEBHOOK_BASE_URL=""

# Unified Inbox. Configure a public HTTPS origin (an HTTPS tunnel locally).
MESSAGING_WEBHOOK_BASE_URL=""
# Separate 32-byte base64 key; keep stable to decrypt connected channel tokens.
MESSAGING_TOKEN_ENCRYPTION_KEY=""
# Meta app secret verifies incoming POST signatures; verify token is per channel.
WHATSAPP_APP_SECRET=""
# Required: currently supported Graph API version from your Meta app, e.g. v24.0.
WHATSAPP_API_VERSION=""
# Optional defaults when connecting a channel through the API without these fields.
WHATSAPP_VERIFY_TOKEN=""
TELEGRAM_BOT_TOKEN=""

# Enable only behind a trusted proxy that replaces client-supplied X-Forwarded-For.
# Public forms always limit to 60 submissions/form/minute; trusted IPs also to 5/minute.
FORMS_TRUST_PROXY="false"
