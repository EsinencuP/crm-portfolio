generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  name                  String
  email                 String                  @unique
  passwordHash          String?
  avatarUrl             String?
  role                  Role                    @default(MEMBER)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  contacts              Contact[]               @relation("ContactOwner")
  deals                 Deal[]                  @relation("DealOwner")
  activities            Activity[]
  notes                 Note[]
  accounts              Account[]
  sessions              Session[]
  sentInvites           TeamInvite[]            @relation("InviteSender")
  workspaceMembers      WorkspaceMember[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  emailAccounts         EmailAccount[]
  phoneCalls            PhoneCall[]
  assignedConversations MessagingConversation[] @relation("AssignedConversations")
  messagingMessages     MessagingMessage[]      @relation("MessageSender")
  createdForms          LeadCaptureForm[]
  createdWorkflows      Workflow[]              @relation("WorkflowCreator")
  recordPermissions     RecordPermission[]      @relation("RecordPermissions")
  permissionsGranted    RecordPermission[]      @relation("PermissionsGranted")
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  logoUrl           String?
  defaultCurrency   String             @default("USD")
  timezone          String             @default("UTC")
  plan              WorkspacePlan      @default(FREE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  members           WorkspaceMember[]
  contacts          Contact[]
  companies         Company[]
  deals             Deal[]
  activities        Activity[]
  notes             Note[]
  tags              Tag[]
  pipelineStages    PipelineStage[]
  invites           TeamInvite[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  emailAccounts     EmailAccount[]
  emailMessages     EmailMessage[]
  phoneCalls        PhoneCall[]
  messagingChannels MessagingChannel[]
  leadCaptureForms  LeadCaptureForm[]
  workflows         Workflow[]
  webhooks          Webhook[]
  recordPermissions RecordPermission[]
}

model Workflow {
  id            String          @id @default(cuid())
  name          String
  description   String?
  trigger       WorkflowTrigger
  triggerConfig Json
  canvas        Json?
  isActive      Boolean         @default(true)
  runCount      Int             @default(0)
  lastRunAt     DateTime?
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User            @relation("WorkflowCreator", fields: [createdById], references: [id])
  steps         WorkflowStep[]
  runs          WorkflowRun[]
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([workspaceId, trigger, isActive])
  @@index([workspaceId, createdById, createdAt])
}

enum WorkflowTrigger {
  CONTACT_CREATED
  CONTACT_UPDATED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  DEAL_WON
  DEAL_LOST
  ACTIVITY_COMPLETED
  FORM_SUBMITTED
  EMAIL_RECEIVED
  EMAIL_OPENED
  MANUAL
  SCHEDULED
}

model WorkflowStep {
  id           String           @id @default(cuid())
  workflowId   String
  workflow     Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position     Int
  nodeId       String?
  nextPosition Int?
  elsePosition Int?
  type         WorkflowStepType
  config       Json
  createdAt    DateTime         @default(now())

  @@unique([workflowId, position])
}

enum WorkflowStepType {
  CONDITION
  SEND_EMAIL
  CREATE_TASK
  UPDATE_FIELD
  ASSIGN_OWNER
  ADD_TAG
  MOVE_STAGE
  SEND_NOTIFICATION
  CALL_WEBHOOK
  WAIT
  SEND_WHATSAPP
  ENROLL_SEQUENCE
}

model WorkflowRun {
  id                  String            @id @default(cuid())
  workflowId          String
  workflow            Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  entityType          String
  entityId            String
  status              WorkflowRunStatus @default(RUNNING)
  currentStep         Int               @default(0)
  logs                Json[]            @default([])
  context             Json
  stepsSnapshot       Json
  eventKey            String
  resumeAt            DateTime?
  leaseToken          String?
  leaseExpiresAt      DateTime?
  externalStartedStep Int?
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  error               String?

  @@unique([workflowId, eventKey])
  @@index([workflowId, startedAt])
  @@index([status, resumeAt, leaseExpiresAt])
}

enum WorkflowRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model Webhook {
  id              String            @id @default(cuid())
  name            String
  url             String
  events          String[]
  secret          String?
  headers         Json?
  isActive        Boolean           @default(true)
  lastTriggeredAt DateTime?
  failCount       Int               @default(0)
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workspaceId, isActive])
  @@index([workspaceId, createdAt])
}

model WebhookDelivery {
  id             String         @id @default(cuid())
  webhookId      String
  webhook        Webhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  payloadText    String
  eventKey       String
  endpointUrl    String
  signingSecret  String?
  requestHeaders Json?
  isTest         Boolean        @default(false)
  responseCode   Int?
  responseBody   String?
  duration       Int?
  error          String?
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  nextRetryAt    DateTime?
  leaseToken     String?
  leaseExpiresAt DateTime?
  createdAt      DateTime       @default(now())

  @@unique([webhookId, eventKey])
  @@index([webhookId, createdAt])
  @@index([status, nextRetryAt, leaseExpiresAt])
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model RecordPermission {
  id          String          @id @default(cuid())
  entityType  String
  entityId    String
  userId      String
  user        User            @relation("RecordPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permission  PermissionLevel
  grantedById String
  grantedBy   User            @relation("PermissionsGranted", fields: [grantedById], references: [id])
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, entityType, entityId, userId])
  @@index([workspaceId, entityType, entityId])
  @@index([userId])
}

enum PermissionLevel {
  VIEW
  EDIT
  FULL
  NONE
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String
  entityName  String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([workspaceId, createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EXPORT
  IMPORT
  LOGIN
  LOGOUT
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  body        String?
  link        String?
  read        Boolean          @default(false)
  readAt      DateTime?
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([userId, read])
  @@index([workspaceId])
  @@index([userId, workspaceId, read, createdAt])
}

enum NotificationType {
  DEAL_WON
  DEAL_LOST
  DEAL_STAGE_CHANGED
  TASK_ASSIGNED
  TASK_DUE
  MENTION
  EMAIL_RECEIVED
  EMAIL_OPENED
  EMAIL_CLICKED
  FORM_SUBMISSION
  WORKFLOW_COMPLETED
  IMPORT_COMPLETED
  SEQUENCE_REPLY
  SYSTEM
}

enum WorkspacePlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  role        WorkspaceRole @default(MEMBER)
  isDefault   Boolean       @default(false)
  joinedAt    DateTime      @default(now())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model TeamInvite {
  id          String    @id @default(cuid())
  email       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model AppSettings {
  id        String   @id @default("default")
  appName   String   @default("CRM Portfolio")
  timezone  String   @default("UTC")
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id                     String                  @id @default(cuid())
  workspaceId            String
  workspace              Workspace               @relation(fields: [workspaceId], references: [id])
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  jobTitle               String?
  avatarUrl              String?
  source                 ContactSource           @default(MANUAL)
  status                 ContactStatus           @default(ACTIVE)
  city                   String?
  country                String?
  linkedinUrl            String?
  notes_text             String?
  companyId              String?
  company                Company?                @relation(fields: [companyId], references: [id])
  ownerId                String?
  owner                  User?                   @relation("ContactOwner", fields: [ownerId], references: [id])
  deals                  Deal[]
  activities             Activity[]
  notes                  Note[]
  phoneCalls             PhoneCall[]
  messagingConversations MessagingConversation[]
  formSubmissions        FormSubmission[]
  emailMessages          EmailMessage[]
  tags                   Tag[]
  customFields           Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model LeadCaptureForm {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  fields          Json
  style           Json?
  thankyouMessage String?          @default("Thank you! We'll be in touch.")
  redirectUrl     String?
  assignToId      String?
  tagIds          String[]         @default([])
  pipelineStageId String?
  isActive        Boolean          @default(true)
  submissionCount Int              @default(0)
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  submissions     FormSubmission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([workspaceId, createdAt])
}

model FormSubmission {
  id              String          @id @default(cuid())
  formId          String
  form            LeadCaptureForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  data            Json
  contactId       String?
  contact         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  clientRequestId String
  ipAddress       String?
  userAgent       String?
  referrer        String?
  processed       Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@unique([formId, clientRequestId])
  @@index([formId, createdAt])
  @@index([formId, ipAddress, createdAt])
}

enum ContactSource {
  MANUAL
  IMPORT
  WEBSITE
  REFERRAL
  LINKEDIN
  API
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Company {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  domain      String?
  industry    String?
  size        String?
  logoUrl     String?
  website     String?
  address     String?
  description String?
  phone       String?
  contacts    Contact[]
  deals       Deal[]
  notes       Note[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, domain])
  @@index([workspaceId])
}

model PipelineStage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  color       String    @default("#6366f1")
  position    Int
  probability Int       @default(0)
  deals       Deal[]

  @@index([workspaceId])
}

model Deal {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  title         String
  value         Decimal?       @db.Decimal(12, 2)
  currency      String         @default("USD")
  closeDate     DateTime?
  priority      DealPriority   @default(MEDIUM)
  description   String?
  stageId       String
  stage         PipelineStage  @relation(fields: [stageId], references: [id])
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id])
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  ownerId       String?
  owner         User?          @relation("DealOwner", fields: [ownerId], references: [id])
  activities    Activity[]
  notes         Note[]
  phoneCalls    PhoneCall[]
  emailMessages EmailMessage[]
  tags          Tag[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([workspaceId])
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  type        ActivityType
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean      @default(false)
  completedAt DateTime?
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id])
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id])
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  FOLLOW_UP
}

model Note {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  content     String
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  color       String    @default("#3b82f6")
  contacts    Contact[]
  deals       Deal[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model EmailAccount {
  id             String         @id @default(cuid())
  provider       EmailProvider
  email          String
  displayName    String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  syncEnabled    Boolean        @default(true)
  lastSyncAt     DateTime?
  syncCursor     String?
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages       EmailMessage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([email, workspaceId])
  @@index([userId, workspaceId])
}

enum EmailProvider {
  GMAIL
  OUTLOOK
  SMTP
}

model EmailMessage {
  id          String         @id @default(cuid())
  externalId  String?
  threadId    String?
  direction   EmailDirection
  from        String
  to          String[]
  cc          String[]       @default([])
  bcc         String[]       @default([])
  subject     String
  bodyHtml    String?
  bodyText    String?
  snippet     String?
  sentAt      DateTime?
  receivedAt  DateTime?
  status      EmailStatus    @default(DRAFT)
  trackingId  String?        @unique
  openedAt    DateTime?
  openCount   Int            @default(0)
  clickedAt   DateTime?
  clickCount  Int            @default(0)
  accountId   String
  account     EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@unique([accountId, externalId])
  @@index([threadId])
  @@index([contactId])
  @@index([accountId])
  @@index([workspaceId, receivedAt])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

model PhoneCall {
  id             String        @id @default(cuid())
  direction      CallDirection
  status         CallStatus
  fromNumber     String
  toNumber       String
  duration       Int?
  recordingUrl   String?
  transcript     String?
  notes          String?
  provider       String        @default("twilio")
  externalId     String?       @unique
  dialExternalId String?       @unique
  dialStarted    Boolean       @default(false)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([contactId])
  @@index([userId])
  @@index([workspaceId, createdAt])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  VOICEMAIL
  FAILED
}

model MessagingChannel {
  id            String                  @id @default(cuid())
  platform      MessagingPlatform
  channelId     String
  channelName   String
  phoneNumber   String?
  botUsername   String?
  accessToken   String?
  webhookSecret String?
  isActive      Boolean                 @default(true)
  workspaceId   String
  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations MessagingConversation[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([platform, channelId])
  @@index([workspaceId])
}

enum MessagingPlatform {
  WHATSAPP
  TELEGRAM
}

model MessagingConversation {
  id            String             @id @default(cuid())
  externalId    String
  displayName   String?
  channelId     String
  channel       MessagingChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    User?              @relation("AssignedConversations", fields: [assignedToId], references: [id], onDelete: SetNull)
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  unreadCount   Int                @default(0)
  messages      MessagingMessage[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([channelId, externalId])
  @@index([contactId])
  @@index([channelId, lastMessageAt])
  @@index([assignedToId])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model MessagingMessage {
  id              String                @id @default(cuid())
  externalId      String?
  clientRequestId String?
  conversationId  String
  conversation    MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction       MessageDirection
  content         String?
  mediaUrl        String?
  mediaId         String?
  mediaType       String?
  status          MessageDeliveryStatus @default(SENT)
  sentAt          DateTime              @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?
  senderId        String?
  sender          User?                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@unique([conversationId, externalId])
  @@unique([conversationId, clientRequestId])
  @@index([conversationId, sentAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}
