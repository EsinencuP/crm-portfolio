generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  passwordHash       String?
  avatarUrl          String?
  role               Role               @default(MEMBER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  contacts           Contact[]          @relation("ContactOwner")
  deals              Deal[]             @relation("DealOwner")
  activities         Activity[]
  notes              Note[]
  accounts           Account[]
  sessions           Session[]
  sentInvites        TeamInvite[]       @relation("InviteSender")
  workspaceMembers   WorkspaceMember[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  emailAccounts      EmailAccount[]
  recordPermissions  RecordPermission[] @relation("RecordPermissions")
  permissionsGranted RecordPermission[] @relation("PermissionsGranted")
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  logoUrl           String?
  defaultCurrency   String             @default("USD")
  timezone          String             @default("UTC")
  plan              WorkspacePlan      @default(FREE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  members           WorkspaceMember[]
  contacts          Contact[]
  companies         Company[]
  deals             Deal[]
  activities        Activity[]
  notes             Note[]
  tags              Tag[]
  pipelineStages    PipelineStage[]
  invites           TeamInvite[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  emailAccounts     EmailAccount[]
  emailMessages     EmailMessage[]
  recordPermissions RecordPermission[]
}

model RecordPermission {
  id          String          @id @default(cuid())
  entityType  String
  entityId    String
  userId      String
  user        User            @relation("RecordPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permission  PermissionLevel
  grantedById String
  grantedBy   User            @relation("PermissionsGranted", fields: [grantedById], references: [id])
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, entityType, entityId, userId])
  @@index([workspaceId, entityType, entityId])
  @@index([userId])
}

enum PermissionLevel {
  VIEW
  EDIT
  FULL
  NONE
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String
  entityName  String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([workspaceId, createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EXPORT
  IMPORT
  LOGIN
  LOGOUT
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  body        String?
  link        String?
  read        Boolean          @default(false)
  readAt      DateTime?
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([userId, read])
  @@index([workspaceId])
  @@index([userId, workspaceId, read, createdAt])
}

enum NotificationType {
  DEAL_WON
  DEAL_LOST
  DEAL_STAGE_CHANGED
  TASK_ASSIGNED
  TASK_DUE
  MENTION
  EMAIL_RECEIVED
  EMAIL_OPENED
  EMAIL_CLICKED
  FORM_SUBMISSION
  WORKFLOW_COMPLETED
  IMPORT_COMPLETED
  SEQUENCE_REPLY
  SYSTEM
}

enum WorkspacePlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  role        WorkspaceRole @default(MEMBER)
  isDefault   Boolean       @default(false)
  joinedAt    DateTime      @default(now())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model TeamInvite {
  id          String    @id @default(cuid())
  email       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model AppSettings {
  id        String   @id @default("default")
  appName   String   @default("CRM Portfolio")
  timezone  String   @default("UTC")
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  firstName     String
  lastName      String
  email         String?
  phone         String?
  jobTitle      String?
  avatarUrl     String?
  source        ContactSource  @default(MANUAL)
  status        ContactStatus  @default(ACTIVE)
  city          String?
  country       String?
  linkedinUrl   String?
  notes_text    String?
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  ownerId       String?
  owner         User?          @relation("ContactOwner", fields: [ownerId], references: [id])
  deals         Deal[]
  activities    Activity[]
  notes         Note[]
  emailMessages EmailMessage[]
  tags          Tag[]
  customFields  Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

enum ContactSource {
  MANUAL
  IMPORT
  WEBSITE
  REFERRAL
  LINKEDIN
  API
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Company {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  domain      String?
  industry    String?
  size        String?
  logoUrl     String?
  website     String?
  address     String?
  description String?
  phone       String?
  contacts    Contact[]
  deals       Deal[]
  notes       Note[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, domain])
  @@index([workspaceId])
}

model PipelineStage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  color       String    @default("#6366f1")
  position    Int
  probability Int       @default(0)
  deals       Deal[]

  @@index([workspaceId])
}

model Deal {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  title         String
  value         Decimal?       @db.Decimal(12, 2)
  currency      String         @default("USD")
  closeDate     DateTime?
  priority      DealPriority   @default(MEDIUM)
  description   String?
  stageId       String
  stage         PipelineStage  @relation(fields: [stageId], references: [id])
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id])
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  ownerId       String?
  owner         User?          @relation("DealOwner", fields: [ownerId], references: [id])
  activities    Activity[]
  notes         Note[]
  emailMessages EmailMessage[]
  tags          Tag[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([workspaceId])
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  type        ActivityType
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean      @default(false)
  completedAt DateTime?
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id])
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id])
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  FOLLOW_UP
}

model Note {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  content     String
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  color       String    @default("#3b82f6")
  contacts    Contact[]
  deals       Deal[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model EmailAccount {
  id             String         @id @default(cuid())
  provider       EmailProvider
  email          String
  displayName    String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  syncEnabled    Boolean        @default(true)
  lastSyncAt     DateTime?
  syncCursor     String?
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages       EmailMessage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([email, workspaceId])
  @@index([userId, workspaceId])
}

enum EmailProvider {
  GMAIL
  OUTLOOK
  SMTP
}

model EmailMessage {
  id          String         @id @default(cuid())
  externalId  String?
  threadId    String?
  direction   EmailDirection
  from        String
  to          String[]
  cc          String[]       @default([])
  bcc         String[]       @default([])
  subject     String
  bodyHtml    String?
  bodyText    String?
  snippet     String?
  sentAt      DateTime?
  receivedAt  DateTime?
  status      EmailStatus    @default(DRAFT)
  trackingId  String?        @unique
  openedAt    DateTime?
  openCount   Int            @default(0)
  clickedAt   DateTime?
  clickCount  Int            @default(0)
  accountId   String
  account     EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@unique([accountId, externalId])
  @@index([threadId])
  @@index([contactId])
  @@index([accountId])
  @@index([workspaceId, receivedAt])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}
